{
  "name": "metas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend privado do aplicativo de metas.",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:admin:bootstrap": "tsx src/database/admin/bootstrap.ts",
    "db:admin:bootstrap:test": "tsx src/database/admin/bootstrap.ts test",
    "db:admin:check:northflank": "tsx src/database/admin/bootstrap.ts northflank-check",
    "db:admin:roles:northflank": "tsx src/database/admin/bootstrap.ts northflank-roles",
    "db:admin:roles:status:northflank": "tsx src/database/admin/inspectRoles.ts",
    "db:admin:bootstrap:northflank": "tsx src/database/admin/bootstrap.ts northflank",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:migrate:status": "tsx src/database/migrate.ts status",
    "db:migrate:test": "tsx src/database/migrate.ts test-up",
    "db:migrate:northflank": "tsx src/database/migrate.ts northflank-up",
    "db:migrate:status:northflank": "tsx src/database/migrate.ts northflank-status",
    "db:migrate:diagnose:northflank": "tsx src/database/diagnoseMigrationConnection.ts",
    "db:inspect:northflank": "tsx src/database/admin/inspectMigratedSchema.ts",
    "platform-admin:bootstrap": "tsx src/database/admin/bootstrapPlatformAdmin.ts",
    "platform-admin:bootstrap:northflank": "tsx src/database/admin/bootstrapPlatformAdmin.ts northflank",
    "platform-admin:first-enrollment:status": "tsx src/database/admin/managePlatformAdminFirstEnrollment.ts status",
    "platform-admin:first-enrollment:approve": "tsx src/database/admin/managePlatformAdminFirstEnrollment.ts approve",
    "platform-admin:first-enrollment:status:northflank": "tsx src/database/admin/managePlatformAdminFirstEnrollment.ts status northflank",
    "platform-admin:first-enrollment:approve:northflank": "tsx src/database/admin/managePlatformAdminFirstEnrollment.ts approve northflank",
    "platform-admin:recovery:status": "tsx src/database/admin/managePlatformAdminMfaRecovery.ts status",
    "platform-admin:recovery:approve": "tsx src/database/admin/managePlatformAdminMfaRecovery.ts approve",
    "platform-admin:recovery:status:northflank": "tsx src/database/admin/managePlatformAdminMfaRecovery.ts status northflank",
    "platform-admin:recovery:approve:northflank": "tsx src/database/admin/managePlatformAdminMfaRecovery.ts approve northflank",
    "platform-admin:redis:check:northflank": "tsx src/database/admin/checkPlatformAdminRedis.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/foundation.test.ts tests/database-context.test.ts tests/google-id-token-verifier.test.ts tests/auth-http.test.ts tests/platform-admin-foundation.test.ts tests/platform-admin-http.test.ts tests/platform-admin-rate-limiter.test.ts tests/platform-admin-redis-check.test.ts tests/employees-http.test.ts tests/goals-http.test.ts tests/campaigns-http.test.ts tests/realtime.test.ts tests/migration-connection-diagnostic.test.ts",
    "test:rate-limit:integration": "tsx --test tests/platform-admin-rate-limiter.integration.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/postgresql.integration.test.ts tests/authentication.integration.test.ts tests/platform-admin.integration.test.ts tests/employees.integration.test.ts tests/goals.integration.test.ts tests/campaigns.integration.test.ts",
    "test:integration:northflank": "tsx src/database/admin/validateNorthflank.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "redis": "6.2.1",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
